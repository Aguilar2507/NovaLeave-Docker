{
  "uid": "novaleave-overview",
  "title": "NovaLeave \u2014 Overview",
  "description": "Application health and vacation-request process health. Provisioned by spec_007; edit the JSON in docker/grafana/provisioning/dashboards/, not the UI.",
  "tags": [
    "novaleave",
    "spec_007"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "Vacation request process",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "type": "stat",
      "id": 1,
      "title": "Requests awaiting approval",
      "description": "Current Pending count. Refreshed every 15s by VacationRequestMetricsCollector. A gap means the collector could not reach the database \u2014 deliberately not shown as zero.",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "novaleave-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "novaleave_vacation_requests_pending{job=\"novaleave-web\"}",
          "legendFormat": "pending"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "red",
                "value": 25
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Oldest request still waiting",
      "description": "Age of the oldest Pending request. THIS IS THE STALL SIGNAL. Auto-expiry is not implemented (docs/Keep-in-mind.md item 2), so nothing resolves a request that an approver never acts on \u2014 this value will simply keep climbing. Absent when the queue is empty.",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "novaleave-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "novaleave_vacation_request_oldest_pending_age_seconds{job=\"novaleave-web\"}",
          "legendFormat": "oldest"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 172800
              },
              {
                "color": "red",
                "value": 432000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "State transitions",
      "description": "Transitions over the selected range. NOTE: request CREATION appears as Pending \u2192 Pending \u2014 CreateRequestHandler uses Pending as the 'from' status by convention, so there is no None state. It is the only self-transition.",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "novaleave-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (from_status, to_status) (increase(novaleave_vacation_request_transitions_total{job=\"novaleave-web\"}[$__rate_interval]))",
          "legendFormat": "{{from_status}} \u2192 {{to_status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "type": "row",
      "id": 101,
      "title": "Application health",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "collapsed": false
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Target up",
      "description": "Prometheus's own view of whether the application is scrapeable. 0 means the app is down or unreachable \u2014 distinct from 'the app is idle'.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "novaleave-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"novaleave-web\"}",
          "legendFormat": "up"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "timeseries",
      "id": 5,
      "title": "Request rate by route",
      "description": "Labelled by ROUTE TEMPLATE, not raw path \u2014 that is what keeps cardinality bounded (research.md R-005).",
      "gridPos": {
        "h": 5,
        "w": 10,
        "x": 4,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "novaleave-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count{job=\"novaleave-web\"}[$__rate_interval]))",
          "legendFormat": "{{http_route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "type": "timeseries",
      "id": 6,
      "title": "Responses by status class",
      "description": "5xx is the error signal; 4xx is usually client behaviour (validation, auth) and is shown separately on purpose.",
      "gridPos": {
        "h": 5,
        "w": 10,
        "x": 14,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "novaleave-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{job=\"novaleave-web\"}[$__rate_interval]))",
          "legendFormat": "{{http_response_status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "Request latency (p50 / p95 / p99)",
      "description": "Constitution \u00a712.1 targets: p95 < 300ms for focused operations, < 500ms for standard MVC pages. NOTE: measurements taken on this stack are NOT valid for \u00a712.1 verification \u2014 SQL Server runs emulated on arm64 (spec_005 R-002).",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "novaleave-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"novaleave-web\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"novaleave-web\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"novaleave-web\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "type": "timeseries",
      "id": 8,
      "title": "Authentication attempts",
      "description": "Success vs failure. Failures are NOT broken down by reason \u2014 spec_004 requires that failures never reveal whether an account exists, and /metrics has no authentication in front of it.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "datasource": {
        "type": "prometheus",
        "uid": "novaleave-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (increase(novaleave_authentication_attempts_total{job=\"novaleave-web\"}[$__rate_interval]))",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "type": "row",
      "id": 102,
      "title": "Database and runtime",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "EF Core query rate",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "novaleave-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(microsoft_entityframeworkcore_queries_total{job=\"novaleave-web\"}[$__rate_interval]))",
          "legendFormat": "queries/s"
        },
        {
          "refId": "B",
          "expr": "sum(rate(microsoft_entityframeworkcore_savechanges_total{job=\"novaleave-web\"}[$__rate_interval]))",
          "legendFormat": "savechanges/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "Optimistic concurrency failures",
      "description": "RowVersion conflicts. Worth watching closely: the tests covering optimistic concurrency are SKIPPED (docs/Keep-in-mind.md item 8), so this is currently the only live signal for that invariant.",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "novaleave-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(microsoft_entityframeworkcore_optimistic_concurrency_failures_total{job=\"novaleave-web\"}[$__rate_interval]))",
          "legendFormat": "conflicts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        }
      }
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "Memory and GC",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "novaleave-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "dotnet_process_memory_working_set_bytes{job=\"novaleave-web\"}",
          "legendFormat": "working set"
        },
        {
          "refId": "B",
          "expr": "sum(dotnet_gc_last_collection_heap_size_bytes{job=\"novaleave-web\"})",
          "legendFormat": "gc heap"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "type": "row",
      "id": 103,
      "title": "Logs",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "collapsed": false
    },
    {
      "type": "logs",
      "id": 104,
      "title": "Application warnings and errors",
      "description": "Live from Loki. NOTE the field names: LogQL's `| json` parser sanitises CLEF's @-prefixed keys, so @l becomes _l, @t becomes _t and @mt becomes _mt. Information-level lines omit @l entirely (CLEF convention), which is why this filter shows warnings and above. Enriched properties keep their names: follow one request with `{service=\"web\"} | json | CorrelationId=\"<id>\"`. CorrelationId is deliberately NOT a Loki label -- it is unbounded, and labels are what Loki holds in memory.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "loki",
        "uid": "novaleave-loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "novaleave-loki"
          },
          "expr": "{service=\"web\"} | json | _l =~ `Warning|Error|Fatal`",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ]
}