{
  "uid": "novaleave-dotnet-runtime",
  "title": ".NET Runtime",
  "description": "Runtime health from the System.Runtime meter (19 instruments). Built for NovaLeave because the .NET team's published dashboards (grafana.com 19924/19925) cover ASP.NET Core HTTP only and no community dashboard targets OpenTelemetry dotnet_* naming.",
  "tags": [
    "novaleave",
    "dotnet",
    "spec_007"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "editable": false,
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "novaleave-prometheus"
        },
        "query": {
          "query": "label_values(dotnet_process_cpu_count,job)",
          "refId": "var-job"
        },
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "novaleave-web",
          "value": "novaleave-web"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "Process",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "CPU usage",
      "description": "CPU-seconds consumed per second. 1.0 = one core saturated. Compare against dotnet_process_cpu_count.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "novaleave-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "novaleave-prometheus"
          },
          "expr": "sum by (cpu_mode) (rate(dotnet_process_cpu_time_seconds_total{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{cpu_mode}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 25,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Memory",
      "description": "Working set is what the OS sees; GC heap is managed memory. A gap between them that keeps growing suggests unmanaged or fragmentation pressure.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "novaleave-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "novaleave-prometheus"
          },
          "expr": "dotnet_process_memory_working_set_bytes{job=\"$job\"}",
          "legendFormat": "working set"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "novaleave-prometheus"
          },
          "expr": "sum(dotnet_gc_last_collection_heap_size_bytes{job=\"$job\"})",
          "legendFormat": "GC heap (all gens)"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "novaleave-prometheus"
          },
          "expr": "dotnet_gc_last_collection_memory_committed_size_bytes{job=\"$job\"}",
          "legendFormat": "committed"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 4,
      "title": "Loaded assemblies / active timers",
      "description": "Assemblies should plateau after startup. Timers climbing without bound usually means timers are created per-request and never disposed.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "novaleave-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "novaleave-prometheus"
          },
          "expr": "dotnet_assembly_count{job=\"$job\"}",
          "legendFormat": "assemblies"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "novaleave-prometheus"
          },
          "expr": "dotnet_timer_count{job=\"$job\"}",
          "legendFormat": "timers"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "id": 5,
      "title": "Garbage collection",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "id": 6,
      "title": "Collections per second",
      "description": "gen0 is cheap and frequent. Sustained gen2 activity is the one to worry about: it is a full blocking collection.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "novaleave-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "novaleave-prometheus"
          },
          "expr": "sum by (gc_heap_generation) (rate(dotnet_gc_collections_total{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{gc_heap_generation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 25,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "Time spent paused for GC",
      "description": "Seconds of GC pause per second of wall clock. Above ~0.05 (5%) the GC is eating measurable throughput.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "novaleave-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "novaleave-prometheus"
          },
          "expr": "rate(dotnet_gc_pause_time_seconds_total{job=\"$job\"}[$__rate_interval])",
          "legendFormat": "pause fraction"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 8,
      "title": "Allocation rate",
      "description": "Bytes allocated per second. High allocation is the usual root cause of high gen0 collection rates.",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "novaleave-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "novaleave-prometheus"
          },
          "expr": "rate(dotnet_gc_heap_total_allocated_bytes_total{job=\"$job\"}[$__rate_interval])",
          "legendFormat": "allocated/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "Heap size by generation",
      "description": "Measured after the last collection. loh = large object heap, poh = pinned object heap; growth in those is harder to reclaim.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "novaleave-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "novaleave-prometheus"
          },
          "expr": "dotnet_gc_last_collection_heap_size_bytes{job=\"$job\"}",
          "legendFormat": "{{gc_heap_generation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 25,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "Heap fragmentation",
      "description": "Unusable space between live objects. Persistent fragmentation in loh/poh is a common cause of memory that never comes back.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "novaleave-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "novaleave-prometheus"
          },
          "expr": "dotnet_gc_last_collection_heap_fragmentation_size_bytes{job=\"$job\"}",
          "legendFormat": "{{gc_heap_generation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "id": 11,
      "title": "Thread pool and contention",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "id": 12,
      "title": "Thread pool threads / queue",
      "description": "A queue that grows while thread count is flat is thread-pool starvation \u2014 classically caused by blocking on async code (.Result / .Wait()), which Constitution 2.VIII prohibits.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "novaleave-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "novaleave-prometheus"
          },
          "expr": "dotnet_thread_pool_thread_count_total{job=\"$job\"}",
          "legendFormat": "threads"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "novaleave-prometheus"
          },
          "expr": "dotnet_thread_pool_queue_length_total{job=\"$job\"}",
          "legendFormat": "queued work items"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 13,
      "title": "Work item throughput / lock contention",
      "description": "Lock contention rising with load means threads are serialising on a shared lock.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "novaleave-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "novaleave-prometheus"
          },
          "expr": "rate(dotnet_thread_pool_work_item_count_total{job=\"$job\"}[$__rate_interval])",
          "legendFormat": "work items/s"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "novaleave-prometheus"
          },
          "expr": "rate(dotnet_monitor_lock_contentions_total{job=\"$job\"}[$__rate_interval])",
          "legendFormat": "lock contentions/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "row",
      "id": 14,
      "title": "Exceptions and JIT",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "id": 15,
      "title": "Exceptions thrown",
      "description": "Counts every thrown exception, including handled ones. SqlException and SocketException during startup are expected: DatabaseInitializer retries until SQL Server is query-ready.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "novaleave-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "novaleave-prometheus"
          },
          "expr": "sum by (error_type) (rate(dotnet_exceptions_total{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{error_type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 25,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 16,
      "title": "JIT activity",
      "description": "Heavy at startup, then near zero. A sustained rate later means code paths are still being reached for the first time.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "novaleave-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "novaleave-prometheus"
          },
          "expr": "rate(dotnet_jit_compiled_methods_total{job=\"$job\"}[$__rate_interval])",
          "legendFormat": "methods/s"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "novaleave-prometheus"
          },
          "expr": "rate(dotnet_jit_compilation_time_seconds_total{job=\"$job\"}[$__rate_interval])",
          "legendFormat": "compile time/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}