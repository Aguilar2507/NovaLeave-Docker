# NovaLeave -- local development environment (spec_005 T203 / FR-011).
#
# Copy this file before starting the stack:
#
#     cp .env.example .env
#
# .env is git-ignored. Every value here is DEVELOPMENT-ONLY and grants access to nothing
# but a disposable local container. Never put a real credential in either file --
# Constitution §7.2 requires secrets to live outside the repository, in a managed store.

# SQL Server SA password.
# Must satisfy SQL Server's complexity policy: at least 8 characters using three of
# uppercase, lowercase, digits, symbols. If it does not, the db container exits during
# startup and the reason appears only in `docker compose logs db` -- it is easily
# mistaken for a corrupt image.
MSSQL_SA_PASSWORD=NovaLeave!Dev2026

# Host port serving the application: http://localhost:8080
# Change this if something already listens on it (FR-012).
WEB_PORT=8080

# Host port for attaching a database client (Azure Data Studio, DataGrip, sqlcmd).
# Connect with: server localhost,1433 -- user sa -- the password above.
DB_PORT=1433

# --- Observability (spec_007) ------------------------------------------------
# Prometheus expression browser: http://localhost:9090
# This publishes PROMETHEUS itself. The application's /metrics endpoint is deliberately not
# published to the host -- only Prometheus reaches it, over the Docker network (FR-018).
PROMETHEUS_PORT=9090

# Grafana dashboards: http://localhost:3000
GRAFANA_PORT=3000

# Grafana admin credentials. DEVELOPMENT ONLY -- this grants access to dashboards showing
# route names, traffic volume and error patterns, so it is a real credential in any deployed
# environment and must come from a managed secret store there (Constitution §7.2).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=NovaLeave!Grafana2026

# Loki log store: http://localhost:3100 (API only; read logs through Grafana).
# Like Prometheus, Loki runs WITHOUT authentication -- fine bound to localhost, never in a
# deployed environment.
LOKI_PORT=3100

# --- AI agents (spec_010) ----------------------------------------------------
# Gemini API key, from https://aistudio.google.com/apikey.
# Read by `docker compose run --rm ops-agent`. The dev team reads the variable from your shell
# instead, since it runs outside Compose: `export GOOGLE_API_KEY=...` before `docker agent run`.
#
# Unlike everything else in this file, this IS a real credential tied to your Google account.
# Leave it empty here, set it only in your git-ignored .env, and leave it empty to use the local
# model instead (`docker compose run --rm ops-agent-local`, no key needed). With the cloud model,
# prompts -- including the logs, metrics and code the agents read -- are sent to Google. On the
# Gemini API's FREE tier, Google may also use that content to improve its products; use a
# billed key for anything beyond this repository's seeded development data.
#
# docker-agent's own usage telemetry is disabled inside the ops-agent services. For the dev
# team, run `export TELEMETRY_ENABLED=false` in your shell: its events include command-line
# arguments, which can be your prompt.
GOOGLE_API_KEY=

# Keep this as Development. It is what enables the seeded test accounts and the detailed
# error pages. Setting it to anything else disables seeding; setting it to Production
# additionally blocks automatic migration by design (FR-006).
ASPNETCORE_ENVIRONMENT=Development
