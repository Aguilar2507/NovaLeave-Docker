# NovaLeave -- local development environment (spec_005 T203 / FR-011).
#
# Copy this file before starting the stack:
#
#     cp .env.example .env
#
# .env is git-ignored. Every value here is DEVELOPMENT-ONLY and grants access to nothing
# but a disposable local container. Never put a real credential in either file --
# Constitution §7.2 requires secrets to live outside the repository, in a managed store.

# SQL Server SA password.
# Must satisfy SQL Server's complexity policy: at least 8 characters using three of
# uppercase, lowercase, digits, symbols. If it does not, the db container exits during
# startup and the reason appears only in `docker compose logs db` -- it is easily
# mistaken for a corrupt image.
MSSQL_SA_PASSWORD=NovaLeave!Dev2026

# Host port serving the application: http://localhost:8080
# Change this if something already listens on it (FR-012).
WEB_PORT=8080

# Host port for attaching a database client (Azure Data Studio, DataGrip, sqlcmd).
# Connect with: server localhost,1433 -- user sa -- the password above.
DB_PORT=1433

# Keep this as Development. It is what enables the seeded test accounts and the detailed
# error pages. Setting it to anything else disables seeding; setting it to Production
# additionally blocks automatic migration by design (FR-006).
ASPNETCORE_ENVIRONMENT=Development
