@* 
   Confirmation Modal Component
   spec_003 §1.3 - Modal with focus trap, Escape-close, confirm button NOT pre-focused
   Uses native <dialog> with showModal() for proper stacking and backdrop.

   Parameters (via ViewData):
   - ModalId: unique id for the modal
   - ModalTitle: title text
   - ModalDescription: description text
   - ModalActionType: "primary", "danger", etc.
   - ModalConfirmLabel: text for confirm button
   - ModalFormAction: form action URL for POST
   - ModalIcon: optional icon
*@
@{
    var modalId = ViewData["ModalId"]?.ToString() ?? "confirmModal";
    var modalTitle = ViewData["ModalTitle"]?.ToString() ?? "Confirmar acción";
    var modalDescription = ViewData["ModalDescription"]?.ToString() ?? "¿Estás seguro de realizar esta acción?";
    var modalActionType = ViewData["ModalActionType"]?.ToString() ?? "primary";
    var modalConfirmLabel = ViewData["ModalConfirmLabel"]?.ToString() ?? "Confirmar";
    var modalFormAction = ViewData["ModalFormAction"]?.ToString() ?? "#";
    var modalIcon = ViewData["ModalIcon"]?.ToString() ?? "⚠️";
}

<dialog class="confirmation-dialog" id="@modalId" role="alertdialog" aria-labelledby="@modalId-title" aria-describedby="@modalId-desc" style="background: var(--color-white); border-radius: var(--border-radius-lg); padding: var(--spacing-6); max-width: 500px; border: none; box-shadow: var(--shadow-xl);">
    @if (!string.IsNullOrEmpty(modalIcon))
    {
        <span class="modal__icon" aria-hidden="true" style="font-size: var(--font-size-h1); display: block; text-align: center; margin-bottom: var(--spacing-4);">@modalIcon</span>
    }
    <h2 id="@modalId-title" class="modal__title" style="font-size: var(--font-size-h2); font-weight: var(--font-weight-semibold); margin-bottom: var(--spacing-3); text-align: center;">@modalTitle</h2>
    <p id="@modalId-desc" class="modal__description" style="color: var(--color-text-gray); margin-bottom: var(--spacing-5); text-align: center;">@modalDescription</p>

    <form method="post" action="@modalFormAction">
        @Html.AntiForgeryToken()

        <div class="modal__actions" style="display: flex; gap: var(--spacing-3); justify-content: center;">
            <button type="button" class="btn btn--secondary" data-action="cancel" style="flex: 1;">Cancelar</button>
            <button type="submit" class="btn btn--@modalActionType" data-action="confirm" style="flex: 1;">@modalConfirmLabel</button>
        </div>
    </form>
</dialog>
