@*
   Edit Pending Request
   spec_003 §3.5 - BalanceCard, pre-filled FormFields (dates + reason), computed-days preview, concurrency token
   Model: EditRequestViewModel (T603)
*@
@model NovaLeave.Presentation.Web.ViewModels.EditRequestViewModel
@{
    ViewData["Title"] = "Editar Solicitud";
}

@functions {
    string? FieldError(string key)
    {
        if (ViewData.ModelState.TryGetValue(key, out var entry) && entry.Errors.Count > 0)
        {
            return entry.Errors[0].ErrorMessage;
        }
        return null;
    }
}

<div class="edit-request container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="mb-4">
                <a asp-action="Detail" asp-route-id="@Model.Id" class="text-decoration-none text-muted d-inline-flex align-items-center">
                    <span style="margin-right: 8px;">←</span> Volver al detalle
                </a>
            </div>

            <h1 class="mb-4">Editar Solicitud</h1>

            @{
                ViewData["AvailableDays"] = Model.CurrentBalance;
                ViewData["ReservedDays"] = Model.CurrentRequestedDays;
            }
            @await Html.PartialAsync("Components/_BalanceCard")

            <div class="card" style="padding: var(--spacing-6);">
                <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="request-form needs-validation" novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="form-field mb-4">
                        <label asp-for="StartDate" class="form-field__label">
                            Fecha de inicio <span class="form-field__required">*</span>
                        </label>
                        <input asp-for="StartDate" class="form-field__input" type="date" required value="@Model.StartDate.ToString("yyyy-MM-dd")" />
                        @if (!string.IsNullOrEmpty(FieldError("StartDate")))
                        {
                            <span class="form-field__error" role="alert">@FieldError("StartDate")</span>
                        }
                        else
                        {
                            <span class="form-field__help">Debe ser posterior a hoy.</span>
                        }
                    </div>

                    <div class="form-field mb-4">
                        <label asp-for="EndDate" class="form-field__label">
                            Fecha de fin <span class="form-field__required">*</span>
                        </label>
                        <input asp-for="EndDate" class="form-field__input" type="date" required value="@Model.EndDate.ToString("yyyy-MM-dd")" />
                        @if (!string.IsNullOrEmpty(FieldError("EndDate")))
                        {
                            <span class="form-field__error" role="alert">@FieldError("EndDate")</span>
                        }
                        else
                        {
                            <span class="form-field__help">Debe ser posterior a la fecha de inicio.</span>
                        }
                    </div>

                    <div class="mb-4 p-3" style="background-color: var(--color-light-gray); border-radius: var(--border-radius-md);" aria-live="polite">
                        <span class="computed-days__label">Días laborables:</span>
                        <span class="computed-days__value" id="computed-days"><strong>@Model.CurrentRequestedDays</strong></span>
                    </div>

                    <div class="form-field mb-5">
                        <label asp-for="Reason" class="form-field__label">
                            Motivo <span class="form-field__required">*</span>
                        </label>
                        <textarea asp-for="Reason" class="form-field__input" rows="5" maxlength="500" required placeholder="Describe el motivo de tu solicitud...">@Model.Reason</textarea>
                        @if (!string.IsNullOrEmpty(FieldError("Reason")))
                        {
                            <span class="form-field__error" role="alert">@FieldError("Reason")</span>
                        }
                        else
                        {
                            <span class="form-field__help">Máximo 500 caracteres.</span>
                        }
                    </div>

                    <div class="d-flex justify-content-between gap-3">
                        <a asp-action="Detail" asp-route-id="@Model.Id" class="btn btn--secondary flex-fill">Cancelar</a>
                        <button type="submit" class="btn btn--primary flex-fill">Guardar Cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
