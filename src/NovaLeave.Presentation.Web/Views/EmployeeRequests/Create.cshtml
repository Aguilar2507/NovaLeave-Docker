@model NovaLeave.Presentation.Web.ViewModels.CreateRequestViewModel
@{
    ViewData["Title"] = "Nueva Solicitud de Vacaciones";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="mb-4">
                <a asp-action="Index" class="text-decoration-none text-muted d-inline-flex align-items-center">
                    <span style="margin-right: 8px;">←</span> Volver al panel
                </a>
            </div>

            <h2 class="mb-4">Nueva Solicitud de Vacaciones</h2>

            @if (ViewData.ModelState.ErrorCount > 0)
            {
                <div class="alert alert-danger" role="alert">
                    Por favor, corrija los siguientes errores:
                    <ul class="mb-0 mt-2">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <div class="card" style="padding: var(--spacing-6);">
                <form asp-action="Create" method="post" class="needs-validation" novalidate>
                    @Html.AntiForgeryToken()

                    <div class="form-field mb-4">
                        <label asp-for="StartDate" class="form-field__label">
                            Fecha de inicio <span class="form-field__required">*</span>
                        </label>
                        <input asp-for="StartDate" class="form-field__input" type="date" required placeholder="dd/mm/yyyy" />
                        <span asp-validation-for="StartDate" class="form-field__error"></span>
                        <span class="form-field__help">Debe ser una fecha futura</span>
                    </div>

                    <div class="form-field mb-4">
                        <label asp-for="EndDate" class="form-field__label">
                            Fecha de fin <span class="form-field__required">*</span>
                        </label>
                        <input asp-for="EndDate" class="form-field__input" type="date" required placeholder="dd/mm/yyyy" />
                        <span asp-validation-for="EndDate" class="form-field__error"></span>
                        <span class="form-field__help">Debe ser posterior a la fecha de inicio</span>
                    </div>

                    <div class="mb-4 p-3" style="background-color: var(--color-light-gray); border-radius: var(--border-radius-md);">
                        <span class="computed-days__label">Días hábiles:</span>
                        <span class="computed-days__value" id="computed-days">—</span>
                    </div>

                    <div class="form-field mb-5">
                        <label asp-for="Reason" class="form-field__label">
                            Motivo <span class="form-field__required">*</span>
                        </label>
                        <textarea asp-for="Reason" class="form-field__input" rows="5" maxlength="500" required placeholder="Describe el motivo de tu solicitud..."></textarea>
                        <span asp-validation-for="Reason" class="form-field__error"></span>
                        <span class="form-field__help">Máximo 500 caracteres</span>
                    </div>

                    <div class="d-flex justify-content-between gap-3">
                        <a asp-action="Index" class="btn btn--secondary flex-fill">Cancelar</a>
                        <button type="submit" class="btn btn--primary flex-fill">Enviar solicitud</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
