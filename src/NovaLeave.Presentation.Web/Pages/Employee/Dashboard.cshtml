@page
@model NovaLeave.Presentation.Web.Pages.Employee.DashboardModel
@{
    ViewData["Title"] = "Mi Panel";
}

@functions {
    // Helper para obtener clase CSS del badge según estado
    string GetStatusBadgeClass(NovaLeave.Domain.Entities.RequestStatus status)
    {
        return status switch
        {
            NovaLeave.Domain.Entities.RequestStatus.Pending => "bg-warning text-dark",
            NovaLeave.Domain.Entities.RequestStatus.Approved => "bg-success",
            NovaLeave.Domain.Entities.RequestStatus.Rejected => "bg-danger",
            NovaLeave.Domain.Entities.RequestStatus.Cancelled => "bg-secondary",
            NovaLeave.Domain.Entities.RequestStatus.Voided => "bg-dark",
            NovaLeave.Domain.Entities.RequestStatus.Expired => "bg-danger",
            _ => "bg-secondary"
        };
    }

    // Helper para traducir estado al español
    string GetStatusText(NovaLeave.Domain.Entities.RequestStatus status)
    {
        return status switch
        {
            NovaLeave.Domain.Entities.RequestStatus.Pending => "Pendiente",
            NovaLeave.Domain.Entities.RequestStatus.Approved => "Aprobada",
            NovaLeave.Domain.Entities.RequestStatus.Rejected => "Rechazada",
            NovaLeave.Domain.Entities.RequestStatus.Cancelled => "Cancelada",
            NovaLeave.Domain.Entities.RequestStatus.Voided => "Anulada",
            NovaLeave.Domain.Entities.RequestStatus.Expired => "Expirada",
            _ => status.ToString()
        };
    }
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <h1>Panel del Empleado</h1>
            <p class="lead">Bienvenido, @Model.EmployeeName</p>
        </div>
    </div>

    <!-- Balance Card - Full Width -->
    <div class="row mt-3">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h5 class="card-title">Balance de Vacaciones</h5>
                    <p class="display-4">@Model.Balance días</p>
                    <a href="/EmployeeRequests/Create" class="btn btn-primary mt-2">Nueva Solicitud</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Requests Section Below -->
    <div class="row mt-4">
        <div class="col-12">
            <h3 class="mb-3">Mis Solicitudes</h3>

            @if (Model.Requests.Any())
            {
                <!-- Desktop/Tablet: Table -->
                <div class="table-responsive d-none d-md-block">
                    <table class="request-table">
                        <thead>
                            <tr>
                                <th>Fechas</th>
                                <th>Días</th>
                                <th>Motivo</th>
                                <th>Enviada</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var req in Model.Requests)
                            {
                                <tr>
                                    <td>
                                        @req.StartDate.ToString("dd-MM-yyyy") - @req.EndDate.ToString("dd-MM-yyyy")
                                    </td>
                                    <td>@req.RequestedDays</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(req.Reason) && req.Reason.Length > 50)
                                        {
                                            <span title="@req.Reason">@req.Reason.Substring(0, 50)...</span>
                                        }
                                        else
                                        {
                                            @req.Reason
                                        }
                                    </td>
                                    <td>@req.CreatedAt.ToString("dd-MM-yyyy HH:mm")</td>
                                    <td>
                                        <span class="badge @GetStatusBadgeClass(req.Status)">
                                            @GetStatusText(req.Status)
                                        </span>
                                    </td>
                                    <td>
                                        <a href="/EmployeeRequests/Detail/@req.Id" class="btn btn-sm btn--secondary">Ver</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Mobile: RequestCard list -->
                <div class="d-md-none">
                    @foreach (var req in Model.Requests)
                    {
                        <div class="card mb-3 shadow-sm">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h6 class="mb-0">
                                        @req.StartDate.ToString("dd-MM-yyyy") – @req.EndDate.ToString("dd-MM-yyyy")
                                    </h6>
                                    <span class="badge @GetStatusBadgeClass(req.Status)">
                                        @GetStatusText(req.Status)
                                    </span>
                                </div>
                                <p class="mb-1">
                                    <strong>@req.RequestedDays</strong> días laborables
                                </p>
                                @if (!string.IsNullOrWhiteSpace(req.Reason))
                                {
                                    <p class="text-muted small mb-2">
                                        <strong>Motivo:</strong> 
                                        @if (req.Reason.Length > 80)
                                        {
                                            @req.Reason.Substring(0, 80)<text>...</text>
                                        }
                                        else
                                        {
                                            @req.Reason
                                        }
                                    </p>
                                }
                                <p class="text-muted small mb-2">
                                    <strong>Enviada:</strong> @req.CreatedAt.ToString("dd-MM-yyyy HH:mm")
                                </p>
                                <a href="/EmployeeRequests/Detail/@req.Id" class="btn btn-sm btn-primary">Ver Detalle</a>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- EmptyState component (spec_003) -->
                <div class="alert alert-secondary text-center" role="alert">
                    No tienes solicitudes registradas. <a href="/EmployeeRequests/Create">Crea tu primera solicitud</a>.
                </div>
            }
        </div>
    </div>
</div>
